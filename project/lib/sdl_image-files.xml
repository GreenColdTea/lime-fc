<xml>

	<files id="native-toolkit-sdl_image">

		<section>

			<compilerflag value="-I${NATIVE_TOOLKIT_PATH}/sdl/include" />

		</section>

		<compilerflag value="-I${NATIVE_TOOLKIT_PATH}/custom/sdl_image/external/libtiff/libtiff" />
		<compilerflag value="-I${NATIVE_TOOLKIT_PATH}/custom/sdl_image/external/libjxl/lib/include/jxl" />

		<compilerflag value="-I${NATIVE_TOOLKIT_PATH}/sdl_image/include" />
