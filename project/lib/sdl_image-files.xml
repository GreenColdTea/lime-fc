				<compilerflag value="-DLOAD_PNM" />

				<compilerflag value="-DLOAD_JPG" />
				<compilerflag value="-DLOAD_PNG" />
				<compilerflag value="-DLOAD_WEBP" />
				<compilerflag value="-DLOAD_AVIF" />
				<compilerflag value="-DLOAD_JXL" />
				<compilerflag value="-DLOAD_TIF" />

			</section>

			<compilerflag value="-DSDL_IMAGE_USE_COMMON_BACKEND" if="apple" />

		</section>

		<section>

			<file name="${NATIVE_TOOLKIT_PATH}/sdl_image/src/IMG.c" />
