package lime.graphics;

/**
	An enum with values for image encoding formats
**/
enum ImageFileFormat
{
	/**
		An image file encoded in the AVIF file format
	**/
	AVIF;

	/**
		An image file encoded in the BMP file format
	**/
	BMP;

	/**
		An image file encoded in the CUR file format
	**/
	CUR;

	/**
		An image file encoded in the GIF file format
	**/
	GIF;

	/**
		An image file encoded in the ICO file format
	**/
	ICO;

	/**
		An image file encoded in the JPEG file format
	**/
	JPEG;

	/**
		An image file encoded in the PNG file format
	**/
	PNG;

	/**
		An image file encoded in the TGA file format
	**/
	TGA;

	/**
		An image file encoded in the WEBP file format
	**/
	WEBP;
}